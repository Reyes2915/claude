    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Single crema pill CTA; caramel on hover.",
      "html": "<a class=\"ds-btn-primary\" href=\"#\">Comprar café</a>",
      "css": ".ds-btn-primary{display:inline-block;border-radius:9999px;background:var(--color-crema);color:var(--color-ink);font-family:'DM Sans',ui-sans-serif,system-ui,sans-serif;font-weight:600;font-size:16px;padding:16px 30px;text-decoration:none;transition:background-color 150ms cubic-bezier(0.4,0,0.2,1);}.ds-btn-primary:hover{background:var(--color-caramel);}.ds-btn-primary:focus-visible{outline:2px solid var(--color-caramel);outline-offset:3px;}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary pill on dark; border warms to crema on hover.",
      "html": "<a class=\"ds-btn-ghost\" href=\"#\">Llamar</a>",
      "css": ".ds-btn-ghost{display:inline-block;border-radius:9999px;border:1px solid #4a4a4a;background:transparent;color:var(--color-cream);font-family:'DM Sans',ui-sans-serif,system-ui,sans-serif;font-size:16px;padding:15px 26px;text-decoration:none;transition:border-color 150ms cubic-bezier(0.4,0,0.2,1);}.ds-btn-ghost:hover{border-color:var(--color-crema);}.ds-btn-ghost:focus-visible{outline:2px solid var(--color-caramel);outline-offset:3px;}"
    },
    {
      "name": "Underline Link CTA",
      "kind": "button",
      "refersTo": "button-link",
      "description": "Text-only secondary CTA with warm underline.",
      "html": "<a class=\"ds-link-cta\" href=\"#\">Conoce la suscripción</a>",
      "css": ".ds-link-cta{display:inline-block;color:var(--color-cream);font-family:'DM Sans',ui-sans-serif,system-ui,sans-serif;font-size:16px;padding:16px 8px;border-bottom:1px solid var(--color-crema);text-decoration:none;transition:color 150ms cubic-bezier(0.4,0,0.2,1);}.ds-link-cta:hover{color:var(--color-caramel);}"
    },
    {
      "name": "Header Navigation",
      "kind": "nav",
      "refersTo": "nav-header",
      "description": "Sticky ink bar with blur, serif wordmark, cream links, small crema CTA.",
      "html": "<header class=\"ds-nav\"><a class=\"ds-nav-logo\" href=\"#\"><span class=\"ds-nav-mark\"><span></span></span>Crema &amp; Nogal</a><nav class=\"ds-nav-links\"><a href=\"#\">Cafés</a><a href=\"#\">Suscripción</a><a href=\"#\">Origen</a><a class=\"ds-nav-cta\" href=\"#\">Pedir café</a></nav></header>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px;padding:18px 32px;background:rgb(20 20 20 / .92);backdrop-filter:blur(12px);border-bottom:1px solid var(--color-charcoal);font-family:'DM Sans',ui-sans-serif,system-ui,sans-serif;}.ds-nav-logo{display:flex;align-items:center;gap:10px;color:var(--color-cream);text-decoration:none;font-family:'Playfair Display',ui-serif,Georgia,serif;font-weight:600;font-size:22px;}.ds-nav-mark{display:flex;width:30px;height:30px;align-items:center;justify-content:center;border-radius:50%;background:var(--color-crema);}.ds-nav-mark span{width:12px;height:18px;border:2px solid var(--color-ink);border-radius:50% 50% 50% 50%/60% 60% 40% 40%;}.ds-nav-links{display:flex;flex-wrap:wrap;align-items:center;gap:28px;font-size:15px;}.ds-nav-links a{color:var(--color-cream);text-decoration:none;transition:color 150ms;}.ds-nav-links a:hover{color:var(--color-caramel);}.ds-nav-links a.ds-nav-cta{background:var(--color-crema);color:var(--color-ink);border-radius:9999px;padding:10px 20px;font-size:14px;font-weight:600;}.ds-nav-links a.ds-nav-cta:hover{background:var(--color-caramel);color:var(--color-ink);}"
    },
    {
      "name": "Tasting Note Chips",
      "kind": "chip",
      "refersTo": "chip-note",
      "description": "Oat pills listing cupping notes on product cards.",
      "html": "<ul class=\"ds-chips\"><li>Chocolate</li><li>Nuez</li><li>Panela</li></ul>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0;padding:0;font-family:'DM Sans',ui-sans-serif,system-ui,sans-serif;}.ds-chips li{background:var(--color-oat);color:var(--color-bean);border-radius:9999px;padding:5px 12px;font-size:13px;}"
    },
    {
      "name": "Option Pills",
      "kind": "chip",
      "refersTo": "option-pill",
      "description": "Single-select radio pills; selected fills crema.",
      "html": "<div class=\"ds-options\" role=\"radiogroup\"><button role=\"radio\" aria-checked=\"false\">Cada semana</button><button role=\"radio\" aria-checked=\"true\">Cada 2 semanas</button><button role=\"radio\" aria-checked=\"false\">Cada mes</button></div>",
      "css": ".ds-options{display:flex;flex-wrap:wrap;gap:10px;padding:24px;background:var(--color-charcoal);border-radius:28px;}.ds-options button{flex:1;min-width:120px;cursor:pointer;border-radius:14px;border:1px solid #4a4a4a;background:transparent;color:var(--color-cream);padding:14px 16px;font:600 15px 'DM Sans',ui-sans-serif,system-ui,sans-serif;transition:background-color 150ms,border-color 150ms,color 150ms;}.ds-options button:hover{border-color:var(--color-crema);}.ds-options button[aria-checked=true]{background:var(--color-crema);border-color:var(--color-crema);color:var(--color-ink);}.ds-options button:focus-visible{outline:2px solid var(--color-caramel);outline-offset:2px;}"
    },
    {
      "name": "Method Tabs",
      "kind": "custom",
      "refersTo": "tab",
      "description": "Segmented pill track on cream; selected tab fills bean.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><button role=\"tab\" aria-selected=\"true\">Espresso</button><button role=\"tab\" aria-selected=\"false\">V60</button><button role=\"tab\" aria-selected=\"false\">Prensa francesa</button></div>",
      "css": ".ds-tabs{display:inline-flex;flex-wrap:wrap;gap:8px;padding:6px;border-radius:9999px;background:#e9dccb;}.ds-tabs button{cursor:pointer;border:0;border-radius:9999px;background:transparent;color:var(--color-bean);padding:11px 20px;font:600 15px 'DM Sans',ui-sans-serif,system-ui,sans-serif;transition:background-color 150ms,color 150ms;}.ds-tabs button[aria-selected=true]{background:var(--color-bean);color:var(--color-cream);}.ds-tabs button:focus-visible{outline:2px solid var(--color-roast);outline-offset:2px;}"
    },
    {
      "name": "Newsletter Input",
      "kind": "input",
      "refersTo": "input-pill",
      "description": "Bean pill field on roast band; border warms to caramel on focus.",
      "html": "<form class=\"ds-news\"><input type=\"email\" placeholder=\"tu@correo.com\" aria-label=\"Correo\"><button type=\"submit\">Quiero mi código</button></form>",
      "css": ".ds-news{display:flex;flex-wrap:wrap;gap:10px;padding:32px;background:var(--color-roast);border-radius:28px;font-family:'DM Sans',ui-sans-serif,system-ui,sans-serif;}.ds-news input{flex:1;min-width:220px;border-radius:9999px;border:1px solid #8a5c3c;background:var(--color-bean);color:var(--color-cream);padding:15px 22px;font-size:16px;outline:none;transition:border-color 150ms;}.ds-news input::placeholder{color:#bfa58a;}.ds-news input:focus{border-color:var(--color-caramel);}.ds-news button{cursor:pointer;border:0;border-radius:9999px;background:var(--color-crema);color:var(--color-ink);padding:15px 28px;font-size:16px;font-weight:600;transition:background-color 150ms;}.ds-news button:hover{background:var(--color-caramel);}"
    },
    {
      "name": "Product Card",
      "kind": "card",
      "refersTo": "card-product",
      "description": "Paper card with origin tag, notes, roast meter, price and CTA.",
      "html": "<article class=\"ds-card\"><div class=\"ds-card-img\"><span>Colombia · Huila</span></div><div class=\"ds-card-body\"><h3>Finca La Esperanza</h3><span class=\"ds-card-proc\">Lavado · 1,800 m</span><ul class=\"ds-card-notes\"><li>Panela</li><li>Cacao</li></ul><div class=\"ds-card-roast\"><div><span>Tostado</span><b>Medio</b></div><i><s style=\"width:60%\"></s></i></div><div class=\"ds-card-foot\"><strong>$19 USD</strong><a href=\"#\">Lo quiero</a></div></div></article>",
      "css": ".ds-card{max-width:340px;display:flex;flex-direction:column;overflow:hidden;border-radius:22px;border:1px solid var(--color-sand);background:var(--color-paper);font-family:'DM Sans',ui-sans-serif,system-ui,sans-serif;color:var(--color-ink);}.ds-card-img{position:relative;aspect-ratio:4/3;background:var(--color-bean) repeating-linear-gradient(135deg,rgb(255 255 255/.035) 0 12px,transparent 12px 24px);}.ds-card-img span{position:absolute;top:14px;left:14px;background:var(--color-ink);color:var(--color-cream);border-radius:9999px;padding:6px 12px;font-size:12px;letter-spacing:.06em;}.ds-card-body{display:flex;flex-direction:column;gap:16px;padding:24px 24px 26px;}.ds-card-body h3{margin:0;font:600 26px/1.15 'Playfair Display',ui-serif,Georgia,serif;}.ds-card-proc{margin-top:-10px;font-size:14px;color:var(--color-mocha);}.ds-card-notes{display:flex;gap:8px;list-style:none;margin:0;padding:0;}.ds-card-notes li{background:var(--color-oat);color:var(--color-bean);border-radius:9999px;padding:5px 12px;font-size:13px;}.ds-card-roast div{display:flex;justify-content:space-between;font-size:13px;color:var(--color-mocha);margin-bottom:8px;}.ds-card-roast b{color:var(--color-bean);}.ds-card-roast i{display:block;height:6px;border-radius:9999px;background:var(--color-sand);overflow:hidden;}.ds-card-roast s{display:block;height:100%;border-radius:9999px;background:linear-gradient(to right,var(--color-caramel),var(--color-roast));}.ds-card-foot{display:flex;align-items:center;justify-content:space-between;}.ds-card-foot strong{font-size:24px;color:var(--color-bean);}.ds-card-foot a{border-radius:9999px;background:var(--color-crema);color:var(--color-ink);padding:13px 22px;font-size:15px;font-weight:600;text-decoration:none;transition:background-color 150ms;}.ds-card-foot a:hover{background:var(--color-caramel);}"
    },
    {
