---
/**
 * Contenedor de imagen. Si no hay `src`, muestra un placeholder
 * con la descripción de la foto que debe ir ahí.
 */
interface Props {
  src?: string;
  alt?: string;
  placeholder: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt = '', placeholder, class: className = '', loading = 'lazy' } = Astro.props;
---

<div class:list={['absolute inset-0 overflow-hidden', className]}>
  {
    src ? (
      <img src={src} alt={alt || placeholder} loading={loading} class="size-full object-cover" />
    ) : (
      <div
        role="img"
        aria-label={placeholder}
        class="flex size-full items-center justify-center bg-bean bg-[repeating-linear-gradient(135deg,rgb(255_255_255/.035)_0_12px,transparent_12px_24px)] p-6 text-center text-sm text-caramel/80"
      >
        {placeholder}
      </div>
    )
  }
</div>
