---
/** Grupo de botones tipo "pill" de selección única (radio visual) */
interface Props {
  label: string;
  name: string;
  options: string[];
  selected: number;
  minWidth?: string;
}

const { label, name, options, selected, minWidth = '120px' } = Astro.props;
---

<div class="flex flex-col gap-3" role="radiogroup" aria-label={label} data-option-group={name}>
  <span class="text-sm text-muted">{label}</span>
  <div class="flex flex-wrap gap-2.5">
    {
      options.map((option, i) => (
        <button
          type="button"
          role="radio"
          aria-checked={i === selected ? 'true' : 'false'}
          data-index={i}
          style={{ minWidth }}
          class="press flex-1 cursor-pointer rounded-[14px] border border-line-strong bg-transparent px-4 py-3.5 text-[15px] leading-tight font-medium text-cream transition-[color,background-color,border-color,transform] duration-200 ease-out-expo hover:border-muted active:duration-75 aria-checked:border-crema aria-checked:bg-crema aria-checked:text-ink"
        >
          {option}
        </button>
      ))
    }
  </div>
</div>
