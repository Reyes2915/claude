---
import { site } from '../config/site';
---

<a href="#" class="flex items-center gap-2.5 text-cream hover:text-cream" aria-label={site.name}>
  <span class="flex size-[30px] items-center justify-center rounded-full bg-crema">
    <span class="h-[18px] w-3 rounded-[50%_50%_50%_50%/60%_60%_40%_40%] border-2 border-ink"></span>
  </span>
  <span class="font-serif text-[22px] font-medium tracking-[-.01em]">{site.name}</span>
</a>
