---
import OptionGroup from './OptionGroup.astro';
import { subscription } from '../config/content';
import { pluralize } from '../utils/format';
import { subscriptionQuote } from '../utils/subscription';

const { steps, frequencies, bags, basePrice, discount, defaultFrequency, defaultBags } = subscription;

const initial = subscriptionQuote({
  bags: bags[defaultBags],
  frequencyLabel: frequencies[defaultFrequency].label,
  basePrice,
  discount,
});

const config = { frequencies: frequencies.map((f) => f.label), bags, basePrice, discount };
---

<section id="suscripcion" class="bg-ink">
  <div
    class="container-page section-y grid grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] items-start gap-[clamp(40px,6vw,80px)]"
  >
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-5">
        <h2 class="heading-2">Café recién tostado, sin pensarlo</h2>
        <p class="m-0 max-w-[30em] text-[17px] leading-relaxed text-soft">
          Ahorras {discount * 100}% en cada bolsa. Pausa, salta un envío o cambia de café cuando quieras.
        </p>
      </div>
      <ol class="m-0 flex list-none flex-col border-t border-charcoal p-0">
        {
          steps.map((step, i) => (
            <li class="grid grid-cols-[56px_1fr] gap-4 border-b border-charcoal py-[22px]">
              <span class="font-serif text-[32px] leading-none font-light text-crema tabular-nums">{i + 1}</span>
              <div class="flex flex-col gap-1">
                <strong class="text-lg font-semibold">{step.title}</strong>
                <span class="text-[15px] leading-[1.55] text-muted">{step.description}</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div
      class="flex flex-col gap-7 rounded-[28px] bg-charcoal p-[clamp(28px,3.5vw,44px)]"
      data-subscription
      data-config={JSON.stringify(config)}
    >
      <OptionGroup
        label="Frecuencia"
        name="frequency"
        options={frequencies.map((f) => f.label)}
        selected={defaultFrequency}
        minWidth="88px"
      />
      <OptionGroup
        label="Bolsas por envío"
        name="bags"
        options={bags.map((n) => pluralize(n, 'bolsa', 'bolsas'))}
        selected={defaultBags}
        minWidth="90px"
      />
      <div class="flex flex-wrap items-end justify-between gap-4 border-t border-line pt-6">
        <div class="flex flex-col gap-1" aria-live="polite">
          <span class="inline-block self-start text-sm text-muted" data-summary>{initial.summary}</span>
          <div class="flex items-baseline gap-2.5">
            <span class="font-serif text-[clamp(44px,4vw,56px)] leading-none font-medium tracking-[-.02em] text-cream tabular-nums inline-block" data-price>{initial.price}</span>
            <span class="inline-block text-base text-muted tabular-nums line-through" data-full>{initial.full}</span>
          </div>
        </div>
        <a href="#visitanos" class="btn-primary px-7 py-4 text-base">Suscribirme</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { initSubscription } from '../scripts/subscription';
  initSubscription();
</script>
