---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ValueProps from '../components/ValueProps.astro';
import FeaturedProducts from '../components/FeaturedProducts.astro';
import Subscription from '../components/Subscription.astro';
import Story from '../components/Story.astro';
import BrewGuide from '../components/BrewGuide.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Visit from '../components/Visit.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <AnnouncementBar />
  <Header />
  <main>
    <Hero />
    <ValueProps />
    <FeaturedProducts />
    <Subscription />
    <Story />
    <BrewGuide />
    <Testimonials />
    <Faq />
    <Visit />
    <Newsletter />
  </main>
  <Footer />
</Layout>
